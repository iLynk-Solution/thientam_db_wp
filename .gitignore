# ==========================================
# Git Ignore for site.thientam68.com
# ==========================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Archives & Package files (generated by deploy-plugin.sh)
*.zip
plugins/*.zip
*.tar.gz
*.tgz
*.rar

# Dependencies
node_modules/
vendor/

# Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
*.swp
*~

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# WordPress backups & cache
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
